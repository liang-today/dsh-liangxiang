[Unit]
Description=Liangxiang community backend (soft-trust, not verified production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liangxiang
Group=liangxiang
WorkingDirectory=/opt/liangxiang
EnvironmentFile=/etc/liangxiang.env
ExecStart=/usr/bin/node /opt/liangxiang/lib/backend.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RemoveIPC=true
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/liangxiang/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
