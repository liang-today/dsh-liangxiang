[Unit]
Description=Liangbiao community backend (soft-trust, not verified production)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=liangbiao
Group=liangbiao
WorkingDirectory=/opt/liangbiao
EnvironmentFile=/etc/liangbiao.env
ExecStart=/usr/bin/node /opt/liangbiao/lib/backend.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/liangbiao/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
