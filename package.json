{
  "name": "dsh-liangxiang",
  "version": "0.8.9-beta",
  "description": "用 DeepSeek Harness 凝聚香火，投下一炷夯或拉；众香汇成梁位，共同显出今日梁相。",
  "homepage": "https://liang.today/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liang-today/dsh-liangxiang.git"
  },
  "bugs": {
    "url": "https://github.com/liang-today/dsh-liangxiang/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "liangxiang"
  ],
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "prepare": "tsdown",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "prepack": "bash scripts/swap-readme.sh prepack",
    "postpack": "bash scripts/swap-readme.sh postpack",
    "pack:tarball": "pnpm pack",
    "dev:install": "bash scripts/dev-install.sh",
    "dev:uninstall": "bash scripts/dev-uninstall.sh",
    "dev:dump-config": "bash scripts/dump-config.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:credit": "bash scripts/dev-credit.sh",
    "backend:start": "node lib/backend.js",
    "backend:dev": "pnpm run build && node lib/backend.js",
    "backend:ops": "node lib/backend-cli.js",
    "smoke:clean-profile": "bash scripts/smoke-clean-profile.sh",
    "smoke:online": "bash scripts/smoke-online.sh",
    "reset:staging": "bash scripts/reset-staging.sh",
    "reset:identity": "bash scripts/reset-identity.sh",
    "publish:case": "bash scripts/publish-case.sh",
    "queue:case": "bash scripts/queue-case.sh"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "oxlint": "1.76.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
