{
  "name": "dsh-liangxiang",
  "version": "2.0.1-alpha.1",
  "description": "梁股开盘了！梁相是DeepSeek Harness插件：对话攒香火，夯拉定梁位；早午晚三盘做多做空，午夜揭晓，在线香火与收益跨日保留。",
  "homepage": "https://liang.today/",
  "icon": "./lib/main-nan.webp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liang-today/dsh-liangxiang.git"
  },
  "bugs": {
    "url": "https://github.com/liang-today/dsh-liangxiang/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "liangxiang",
    "梁相",
    "梁股"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "LICENSE",
    "LICENSES/lucide.txt",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/market-whale.webp",
    "lib/main-nan.webp",
    "lib/main-grass.webp",
    "lib/main-fish.webp",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "prepare": "tsdown && node scripts/copy-market-assets.mjs",
    "build": "tsdown && node scripts/copy-market-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "test": "vitest run",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build && pnpm run check:client-budget",
    "prepack": "bash scripts/swap-readme.sh prepack",
    "postpack": "bash scripts/swap-readme.sh postpack",
    "pack:tarball": "pnpm pack",
    "dev:install": "bash scripts/dev-install.sh",
    "dev:uninstall": "bash scripts/dev-uninstall.sh",
    "dev:dump-config": "bash scripts/dump-config.sh",
    "dev:web": "bash scripts/dev-web.sh",
    "dev:repair-cache": "bash scripts/repair-dev-cache.sh",
    "dev:credit": "bash scripts/dev-credit.sh",
    "backend:start": "node lib/backend.js",
    "backend:dev": "pnpm run build && node lib/backend.js",
    "backend:ops": "node lib/backend-cli.js",
    "browser:install": "playwright install chromium",
    "check:client-budget": "node scripts/check-client-budget.mjs",
    "test:browser": "playwright test",
    "smoke:clean-profile": "bash scripts/smoke-clean-profile.sh",
    "smoke:browser-clean-profile": "LIANGXIANG_SMOKE_BROWSER=1 bash scripts/smoke-clean-profile.sh",
    "smoke:browser-profile": "bash scripts/smoke-browser-profile.sh",
    "smoke:online": "bash scripts/smoke-online.sh",
    "reset:staging": "bash scripts/reset-staging.sh",
    "reset:identity": "bash scripts/reset-identity.sh",
    "publish:case": "bash scripts/publish-case.sh",
    "queue:case": "bash scripts/queue-case.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@playwright/test": "1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "oxlint": "1.76.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.4",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1",
    "vitest": "^4.1.8"
  }
}
