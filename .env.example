# Copy to `.env` for local overrides. NEVER commit `.env` or any real key.
# Every variable is optional; the scripts have safe defaults.

# Project-local DSH home used by scripts/ (profiles, storages, settings).
# Default: <repo>/.dsh-home (gitignored). Point it elsewhere if you want the
# dev profile inside your real ~/.dsh instead.
#DSH_HOME=

# Dev profile name (default: liangbiao-dev) and WebUI port (default: 3080).
#LIANGBIAO_PROFILE=
#LIANGBIAO_DEV_PORT=

# Clean-profile smoke test overrides (defaults: liangbiao-smoke / 3981).
#LIANGBIAO_SMOKE_PROFILE=
#LIANGBIAO_SMOKE_PORT=

# Web surface bundle spec installed into dev/smoke profiles.
# Default: @deepseek-ai/dsh-web-app@0.1.0-rc.6
#LIANGBIAO_WEB_APP_SPEC=

# --- Liangbiao host knobs (all optional, dev-facing) ---

# Business timezone for the LOCAL date rollover (IANA id; default Asia/Shanghai).
# Local/dev authority only — an online backend will own the business date.
#LIANGBIAO_BUSINESS_TZ=

# Published global-snapshot refresh cadence in seconds (default 300, min 5).
# Lower it (e.g. 15) for a livelier local demo.
#LIANGBIAO_SNAPSHOT_SECONDS=

# Fake-service seed for the local case: empty (default, zero votes = 待开梁)
# or demo (10,665 夯 / 2,181 拉 / 2,841 香客 — the frozen demo scenario).
#LIANGBIAO_FAKE_SEED=

# Tokens per incense stick (default 50000). Product-frozen; change only for testing.
#LIANGBIAO_TOKEN_PER_INCENSE=

# Only needed to actually chat with a model inside the dev WebUI; the plugin
# skeleton itself requires NO credentials. Prefer your shell environment or
# $DSH_HOME/.credentials.yaml over this file.
#DEEPSEEK_API_KEY=
