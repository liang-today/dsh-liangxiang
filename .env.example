# Copy to `.env` for local overrides. NEVER commit `.env` or any real key.
# Every variable is optional; the scripts have safe defaults.
# v0.5 reads former LIANGBIAO_* names only as a one-release compatibility
# bridge. New configuration and every generated example use LIANGXIANG_*.

# Project-local DSH home used by scripts/ (profiles, storages, settings).
# Default: <repo>/.dsh-home (gitignored). Point it elsewhere if you want the
# dev profile inside your real ~/.dsh instead.
#DSH_HOME=

# Dev profile name (default: liangxiang-dev) and WebUI port (default: 3080).
#LIANGXIANG_PROFILE=
#LIANGXIANG_DEV_PORT=

# Clean-profile smoke test overrides (defaults: liangxiang-smoke / 3981).
#LIANGXIANG_SMOKE_PROFILE=
#LIANGXIANG_SMOKE_PORT=

# Web surface bundle spec installed into dev/smoke profiles.
# Default: @deepseek-ai/dsh-web-app@0.1.0-rc.6
#LIANGXIANG_WEB_APP_SPEC=

# --- Liangxiang host knobs (all optional, dev-facing) ---

# Business timezone for the LOCAL date rollover (IANA id; default Asia/Shanghai).
# Local/dev authority only — an online backend will own the business date.
#LIANGXIANG_BUSINESS_TZ=

# Published global-snapshot refresh cadence in seconds (default 1, min 1).
# Near real time on purpose: a voter must see their own vote move 梁位 within a
# second. Raise it only if a deployment needs to shed load.
#LIANGXIANG_SNAPSHOT_SECONDS=

# Fake-service seed for the local case: empty (default, zero votes = 待开梁)
# or demo (10,665 夯 / 2,181 拉 / 2,841 香客 — the frozen demo scenario).
#LIANGXIANG_FAKE_SEED=

# CLI pump is LOCAL_FAKE_DEV only (no panel demo button):
#   unset LIANGXIANG_BACKEND_URL && pnpm run dev:web
#   pnpm run dev:credit -- 9

# Tokens per incense stick (default 50000). Product-frozen; change only for testing.
#LIANGXIANG_TOKEN_PER_INCENSE=

# --- Online mode (DEV_STAGING_ONLY / community soft trust) ---

# Base URL of the Liangxiang backend. Default is the closed-beta staging
# endpoint (online). Set `local` to force the in-process LOCAL_FAKE_DEV loop.
#LIANGXIANG_BACKEND_URL=local

# Shared admission secret. If the backend has this set, every Host request
# (except /health and /snapshot) must send the same value. Not identity.
#LIANGXIANG_COMMUNITY_KEY=

# --- Liangxiang backend knobs (the standalone `pnpm run backend:start` process) ---

# Listen address/port (defaults 127.0.0.1 / 4180).
# VPS behind Caddy/nginx: keep 127.0.0.1. Direct LAN test: 0.0.0.0.
#LIANGXIANG_BACKEND_HOST=
#LIANGXIANG_BACKEND_PORT=

# SQLite file (default .liangxiang-backend/liangxiang.sqlite, gitignored).
# `:memory:` is supported for throwaway runs.
#LIANGXIANG_BACKEND_DB=

# Authority mode. Only DEV_STAGING_ONLY is accepted: Decision Gate A = A3, so
# VERIFIED_PRODUCTION is blocked and the backend refuses to boot with it.
#LIANGXIANG_AUTHORITY_MODE=DEV_STAGING_ONLY

# Daily case title (default: the frozen DeepSeek Harness 是夯还是拉).
#LIANGXIANG_CASE_TITLE=

# Publish a new 梁案 on the machine that holds the sqlite (VPS CLI, no HTTP):
#   pnpm run publish:case -- "新标题是夯还是拉"
# See docs/121-vps-deploy.md and docs/122-identity-recovery.md.

# Per-installation vote rate limit, requests/minute (default 600; 0 disables).
# Burst-clicking past this returns HTTP 429 and the UI shows「投票失败」.
#LIANGXIANG_VOTE_RATE_LIMIT=

# Hard cap on active installation keys in the vote limiter (default 4096).
# New keys receive 429 while a full 60-second window is occupied.
#LIANGXIANG_VOTE_RATE_LIMIT_MAX_KEYS=

# Max claimed-token growth per minute of identity age (default 50000 = 1 炷/分钟).
# 0 disables the drip (localhost tests / smoke only). Production should keep the default.
#LIANGXIANG_MAX_TOKENS_PER_MINUTE=

# Accept unsigned installation headers (default off). Smoke/curl on localhost only.
#LIANGXIANG_ALLOW_UNSIGNED=

# Wipe Pi sqlite + local vote ledgers (never-voted / 待开梁). Then restart WebUI.
#   pnpm run reset:staging
#   pnpm run reset:staging -- --local
#   pnpm run reset:staging -- --pi
#LIANGXIANG_STAGING_SSH=bean@192.168.2.21

# Only needed to actually chat with a model inside the dev WebUI; the plugin
# skeleton itself requires NO credentials. Prefer your shell environment or
# $DSH_HOME/.credentials.yaml over this file.
#DEEPSEEK_API_KEY=
